(******************************************************************** // 注释
* 项目: 三机床 + 库卡机器人 + 4托盘架 柔性单元控制（模块化） // 注释
* 语言: Siemens SCL // 注释
* 增强点: // 注释
* 1) 判断机床夹紧到位、机器人夹紧到位、托盘放置到位 // 注释
* 2) 托盘40工位逐位跟踪（哪些干完/哪些未干完） // 注释
* 3) 多机床同时完工时，按加工时长自优化调度顺序 // 注释
********************************************************************) // 注释
//
// ========================= 信号总表（类型 + 起始偏移）=========================
// [安全输入]
// Safety.EStopOK                    BOOL  %I0.0
// Safety.SafetyDoorClosed           BOOL  %I0.1
// Safety.AirPressureOK              BOOL  %I0.2
// Safety.ServoReady                 BOOL  %I0.3
// [HMI]
// HMI.CmdStart                      BOOL  %M0.0
// HMI.CmdStop                       BOOL  %M0.1
// HMI.CmdReset                      BOOL  %M0.2
// HMI.ModeAuto                      BOOL  %M0.3
// HMI.AckAlarm                      BOOL  %M0.4
// [机器人输入]
// RobotReady                        BOOL  %I1.0
// RobotFault                        BOOL  %I1.1
// RobotInCycle                      BOOL  %I1.2
// RobotGripOK                       BOOL  %I1.3   // 机器人夹紧到位
// [机床输入(1..3)]
// MachineReadyIn[i]                 BOOL  %I2.x~%I4.x
// MachineFaultIn[i]                 BOOL  %I2.x~%I4.x
// MachineDoorIn[i]                  BOOL  %I2.x~%I4.x
// MachineClampIn[i]                 BOOL  %I2.x~%I4.x   // 机床夹紧到位
// MachineDoneIn[i]                  BOOL  %I2.x~%I4.x
// [托盘到位]
// TrayRawPlaceOK[1..4]              BOOL  %I5.0~%I5.3
// TrayDonePlaceOK[1..4]             BOOL  %I5.4~%I5.7
//
TYPE "E_CellState" : ( // 注释
    ST_INIT, // 注释
    ST_IDLE, // 注释
    ST_AUTO_RUN, // 注释
    ST_STOPPING, // 注释
    ST_FAULT // 注释
); // 注释
END_TYPE // 注释
//
TYPE "E_MachineState" : ( // 注释
    MC_IDLE, // 注释
    MC_WAIT_LOAD, // 注释
    MC_PROCESSING, // 注释
    MC_WAIT_UNLOAD, // 注释
    MC_FAULT // 注释
); // 注释
END_TYPE // 注释
//
TYPE "E_AlarmCode" : ( // 注释
    ALM_NONE, // 注释
    ALM_ESTOP_ACTIVE, // 注释
    ALM_SAFETY_DOOR_OPEN, // 注释
    ALM_AIR_PRESS_LOW, // 注释
    ALM_SERVO_NOT_READY, // 注释
    ALM_MACHINE1_FAULT, // 注释
    ALM_MACHINE2_FAULT, // 注释
    ALM_MACHINE3_FAULT, // 注释
    ALM_NO_RAW_PART, // 注释
    ALM_GRIPPER_MISMATCH, // 注释
    ALM_GRIPPER_EMPTY, // 注释
    ALM_TRAY_FULL, // 注释
    ALM_TRAY_EMPTY, // 注释
    ALM_ROBOT_TIMEOUT, // 注释
    ALM_HANDSHAKE_TIMEOUT, // 注释
    ALM_MACHINE_CLAMP_NOT_OK, // 注释
    ALM_ROBOT_GRIP_NOT_OK, // 注释
    ALM_TRAY_PLACE_NOT_OK // 注释
); // 注释
END_TYPE // 注释
//
TYPE "T_Gripper" : STRUCT // 注释
    Present        : BOOL; // 注释
    Healthy        : BOOL; // 注释
    HasPart        : BOOL; // 注释
    PartID         : DINT; // 注释
    SourceTray     : INT;   // 工件来源托盘
    SourceSlot     : INT;   // 工件来源工位（用于完工追踪）
END_STRUCT; // 注释
END_TYPE // 注释
//
TYPE "T_Tray" : STRUCT // 注释
    Capacity       : INT; // 注释
    RawCount       : INT; // 注释
    DoneCount      : INT; // 注释
    InitDone       : BOOL; // 注释
    RawSlotOccupied  : ARRAY[1..40] OF BOOL; // 原料位占用
    RawSlotProcessed : ARRAY[1..40] OF BOOL; // 该原料位是否已加工完成
    DoneSlotOccupied : ARRAY[1..40] OF BOOL; // 成品位占用
END_STRUCT; // 注释
END_TYPE // 注释
//
TYPE "T_MachineIO" : STRUCT // 注释
    Ready          : BOOL; // 注释
    Fault          : BOOL; // 注释
    DoorClosed     : BOOL; // 注释
    ClampOK        : BOOL; // 注释
    CycleDone      : BOOL; // 注释
END_STRUCT; // 注释
END_TYPE // 注释
//
TYPE "T_MachineCtrl" : STRUCT // 注释
    State          : "E_MachineState"; // 注释
    CurrentPartID  : DINT; // 注释
    CurrentSrcTray : INT; // 注释
    CurrentSrcSlot : INT; // 注释
    ProcessedCount : DINT; // 注释
    LastProcessMs  : DINT; // 注释
    AvgProcessMs   : DINT; // 注释
    LoadReq        : BOOL; // 注释
    UnloadReq      : BOOL; // 注释
    RunCmd         : BOOL; // 注释
END_STRUCT; // 注释
END_TYPE // 注释
//
TYPE "T_HMI" : STRUCT // 注释
    CmdStart       : BOOL; // 注释
    CmdStop        : BOOL; // 注释
    CmdReset       : BOOL; // 注释
    ModeAuto       : BOOL; // 注释
    AckAlarm       : BOOL; // 注释
END_STRUCT; // 注释
END_TYPE // 注释
//
TYPE "T_Safety" : STRUCT // 注释
    EStopOK          : BOOL; // 注释
    SafetyDoorClosed : BOOL; // 注释
    AirPressureOK    : BOOL; // 注释
    ServoReady       : BOOL; // 注释
END_STRUCT; // 注释
END_TYPE // 注释
//
TYPE "T_CellStats" : STRUCT // 注释
    TotalRaw       : DINT; // 注释
    TotalDone      : DINT; // 注释
    TotalInProcess : DINT; // 注释
    RemainingRaw   : DINT; // 注释
    MachineDone    : ARRAY[1..3] OF DINT; // 注释
    MachineAvgMs   : ARRAY[1..3] OF DINT; // 注释
    TrayRawRemain  : ARRAY[1..4] OF DINT; // 注释
    TrayDoneCount  : ARRAY[1..4] OF DINT; // 注释
END_STRUCT; // 注释
END_TYPE // 注释
//
FUNCTION "FC_AlarmTextID" : INT // 注释
VAR_INPUT // 注释
    Code : "E_AlarmCode"; // 注释
END_VAR // 注释
BEGIN // 注释
    CASE Code OF // 注释
        ALM_NONE:                  "FC_AlarmTextID" := 0; // 注释
        ALM_ESTOP_ACTIVE:          "FC_AlarmTextID" := 1001; // 注释
        ALM_SAFETY_DOOR_OPEN:      "FC_AlarmTextID" := 1002; // 注释
        ALM_AIR_PRESS_LOW:         "FC_AlarmTextID" := 1003; // 注释
        ALM_SERVO_NOT_READY:       "FC_AlarmTextID" := 1004; // 注释
        ALM_MACHINE1_FAULT:        "FC_AlarmTextID" := 1101; // 注释
        ALM_MACHINE2_FAULT:        "FC_AlarmTextID" := 1102; // 注释
        ALM_MACHINE3_FAULT:        "FC_AlarmTextID" := 1103; // 注释
        ALM_NO_RAW_PART:           "FC_AlarmTextID" := 1201; // 注释
        ALM_GRIPPER_MISMATCH:      "FC_AlarmTextID" := 1202; // 注释
        ALM_GRIPPER_EMPTY:         "FC_AlarmTextID" := 1203; // 注释
        ALM_TRAY_FULL:             "FC_AlarmTextID" := 1204; // 注释
        ALM_TRAY_EMPTY:            "FC_AlarmTextID" := 1205; // 注释
        ALM_ROBOT_TIMEOUT:         "FC_AlarmTextID" := 1301; // 注释
        ALM_HANDSHAKE_TIMEOUT:     "FC_AlarmTextID" := 1302; // 注释
        ALM_MACHINE_CLAMP_NOT_OK:  "FC_AlarmTextID" := 1401; // 注释
        ALM_ROBOT_GRIP_NOT_OK:     "FC_AlarmTextID" := 1402; // 注释
        ALM_TRAY_PLACE_NOT_OK:     "FC_AlarmTextID" := 1403; // 注释
        ELSE // 注释
            "FC_AlarmTextID" := 1999; // 注释
    END_CASE; // 注释
END_FUNCTION // 注释
//
FUNCTION "FC_CheckSafetyAndAlarm" : "E_AlarmCode" // 注释
VAR_INPUT // 注释
    Safety     : "T_Safety"; // 注释
    M1Fault    : BOOL; // 注释
    M2Fault    : BOOL; // 注释
    M3Fault    : BOOL; // 注释
    RobotFault : BOOL; // 注释
END_VAR // 注释
BEGIN // 注释
    "FC_CheckSafetyAndAlarm" := ALM_NONE; // 注释
    IF NOT Safety.EStopOK THEN // 注释
        "FC_CheckSafetyAndAlarm" := ALM_ESTOP_ACTIVE; // 注释
    ELSIF NOT Safety.SafetyDoorClosed THEN // 注释
        "FC_CheckSafetyAndAlarm" := ALM_SAFETY_DOOR_OPEN; // 注释
    ELSIF NOT Safety.AirPressureOK THEN // 注释
        "FC_CheckSafetyAndAlarm" := ALM_AIR_PRESS_LOW; // 注释
    ELSIF NOT Safety.ServoReady THEN // 注释
        "FC_CheckSafetyAndAlarm" := ALM_SERVO_NOT_READY; // 注释
    ELSIF M1Fault THEN // 注释
        "FC_CheckSafetyAndAlarm" := ALM_MACHINE1_FAULT; // 注释
    ELSIF M2Fault THEN // 注释
        "FC_CheckSafetyAndAlarm" := ALM_MACHINE2_FAULT; // 注释
    ELSIF M3Fault THEN // 注释
        "FC_CheckSafetyAndAlarm" := ALM_MACHINE3_FAULT; // 注释
    ELSIF RobotFault THEN // 注释
        "FC_CheckSafetyAndAlarm" := ALM_ROBOT_TIMEOUT; // 注释
    END_IF; // 注释
END_FUNCTION // 注释
//
FUNCTION_BLOCK "FB_MachineUnit" // 注释
VAR_INPUT // 注释
    Enable      : BOOL; // 注释
    IO          : "T_MachineIO"; // 注释
    PartLoaded  : BOOL; // 注释
END_VAR // 注释
VAR_IN_OUT // 注释
    Ctrl        : "T_MachineCtrl"; // 注释
END_VAR // 注释
VAR // 注释
    T_Process   : TON; // 注释
    RiseDone    : R_TRIG; // 注释
END_VAR // 注释
BEGIN // 注释
    Ctrl.LoadReq := FALSE; // 注释
    Ctrl.UnloadReq := FALSE; // 注释
    Ctrl.RunCmd := FALSE; // 注释
//
    IF (NOT Enable) OR IO.Fault THEN // 注释
        Ctrl.State := MC_FAULT; // 注释
    END_IF; // 注释
//
    CASE Ctrl.State OF // 注释
        MC_IDLE: // 注释
            IF Enable AND IO.Ready AND IO.DoorClosed THEN // 注释
                Ctrl.State := MC_WAIT_LOAD; // 注释
            END_IF; // 注释
//
        MC_WAIT_LOAD: // 注释
            Ctrl.LoadReq := TRUE; // 注释
            IF PartLoaded THEN // 注释
                IF IO.ClampOK THEN // 注释
                    Ctrl.State := MC_PROCESSING; // 注释
                END_IF; // 注释
            END_IF; // 注释
//
        MC_PROCESSING: // 注释
            Ctrl.RunCmd := TRUE; // 注释
            T_Process(IN := TRUE, PT := T#24H); // 注释
            IF IO.CycleDone THEN // 注释
                Ctrl.State := MC_WAIT_UNLOAD; // 注释
            END_IF; // 注释
//
        MC_WAIT_UNLOAD: // 注释
            T_Process(IN := FALSE, PT := T#24H); // 注释
            RiseDone(CLK := IO.CycleDone); // 注释
            IF RiseDone.Q THEN // 注释
                Ctrl.LastProcessMs := TIME_TO_DINT(T_Process.ET); // 注释
                IF Ctrl.AvgProcessMs = 0 THEN // 注释
                    Ctrl.AvgProcessMs := Ctrl.LastProcessMs; // 注释
                ELSE // 注释
                    // EMA近似: 75%历史 + 25%最新
                    Ctrl.AvgProcessMs := (Ctrl.AvgProcessMs * 3 + Ctrl.LastProcessMs) / 4; // 注释
                END_IF; // 注释
            END_IF; // 注释
//
            Ctrl.UnloadReq := TRUE; // 注释
            IF Ctrl.CurrentPartID = 0 THEN // 注释
                Ctrl.ProcessedCount := Ctrl.ProcessedCount + 1; // 注释
                Ctrl.State := MC_WAIT_LOAD; // 注释
            END_IF; // 注释
//
        MC_FAULT: // 注释
            T_Process(IN := FALSE, PT := T#24H); // 注释
            Ctrl.RunCmd := FALSE; // 注释
    END_CASE; // 注释
END_FUNCTION_BLOCK // 注释
//
FUNCTION_BLOCK "FB_RobotDispatcher" // 注释
VAR_INPUT // 注释
    RobotReady      : BOOL; // 注释
    RobotInCycle    : BOOL; // 注释
    RobotGripOK     : BOOL; // 注释
    LoadReq         : ARRAY[1..3] OF BOOL; // 注释
    UnloadReq       : ARRAY[1..3] OF BOOL; // 注释
    TrayRawPlaceOK  : ARRAY[1..4] OF BOOL; // 注释
    TrayDonePlaceOK : ARRAY[1..4] OF BOOL; // 注释
END_VAR // 注释
VAR_IN_OUT // 注释
    Trays           : ARRAY[1..4] OF "T_Tray"; // 注释
    Grippers        : ARRAY[1..4] OF "T_Gripper"; // 注释
    Machines        : ARRAY[1..3] OF "T_MachineCtrl"; // 注释
    PartIDSeed      : DINT; // 注释
END_VAR // 注释
VAR_OUTPUT // 注释
    RobotStartCmd   : BOOL; // 注释
    AlarmCode       : "E_AlarmCode"; // 注释
    SelectedMachine : INT; // 注释
END_VAR // 注释
VAR // 注释
    i, j, k         : INT; // 注释
    SelMachine      : INT; // 注释
    SelTrayRaw      : INT; // 注释
    SelTrayDone     : INT; // 注释
    SelRawSlot      : INT; // 注释
    SelDoneSlot     : INT; // 注释
    BestScore       : DINT; // 注释
    Score           : DINT; // 注释
    T_Handshake     : TON; // 注释
    T_RobotCycle    : TON; // 注释
    AnyNeed         : BOOL; // 注释
    FoundFreeGrip   : BOOL; // 注释
END_VAR // 注释
BEGIN // 注释
    AlarmCode := ALM_NONE; // 注释
    RobotStartCmd := FALSE; // 注释
    SelectedMachine := 0; // 注释
    SelMachine := 0; // 注释
    AnyNeed := FALSE; // 注释
    BestScore := -2147483647; // 注释
//
    // 选择机床策略:
    // 1) 下料优先于上料（避免占机）
    // 2) 若2台以上同时完工请求下料，按 AvgProcessMs 大者优先
    FOR i := 1 TO 3 DO // 注释
        IF LoadReq[i] OR UnloadReq[i] THEN // 注释
            AnyNeed := TRUE; // 注释
            Score := 0; // 注释
            IF UnloadReq[i] THEN // 注释
                Score := Score + 1000000; // 注释
            END_IF; // 注释
            Score := Score + Machines[i].AvgProcessMs; // 注释
            IF Score > BestScore THEN // 注释
                BestScore := Score; // 注释
                SelMachine := i; // 注释
            END_IF; // 注释
        END_IF; // 注释
    END_FOR; // 注释
//
    T_Handshake(IN := AnyNeed AND NOT RobotReady, PT := T#5S); // 注释
    IF T_Handshake.Q THEN // 注释
        AlarmCode := ALM_HANDSHAKE_TIMEOUT; // 注释
        RETURN; // 注释
    END_IF; // 注释
//
    T_RobotCycle(IN := RobotInCycle, PT := T#45S); // 注释
    IF T_RobotCycle.Q THEN // 注释
        AlarmCode := ALM_ROBOT_TIMEOUT; // 注释
        RETURN; // 注释
    END_IF; // 注释
//
    IF (SelMachine = 0) OR (NOT RobotReady) THEN // 注释
        RETURN; // 注释
    END_IF; // 注释
//
    RobotStartCmd := TRUE; // 注释
    SelectedMachine := SelMachine; // 注释
//
    // 先找托盘（且要求托盘到位）
    SelTrayRaw := 0; // 注释
    SelTrayDone := 0; // 注释
    FOR i := 1 TO 4 DO // 注释
        IF (SelTrayRaw = 0) AND (Trays[i].RawCount > 0) THEN // 注释
            IF TrayRawPlaceOK[i] THEN // 注释
                SelTrayRaw := i; // 注释
            ELSE // 注释
                AlarmCode := ALM_TRAY_PLACE_NOT_OK; // 注释
                RETURN; // 注释
            END_IF; // 注释
        END_IF; // 注释
        IF (SelTrayDone = 0) AND (Trays[i].DoneCount < Trays[i].Capacity) THEN // 注释
            IF TrayDonePlaceOK[i] THEN // 注释
                SelTrayDone := i; // 注释
            ELSE // 注释
                AlarmCode := ALM_TRAY_PLACE_NOT_OK; // 注释
                RETURN; // 注释
            END_IF; // 注释
        END_IF; // 注释
    END_FOR; // 注释
//
    // 上料
    IF LoadReq[SelMachine] THEN // 注释
        IF SelTrayRaw = 0 THEN // 注释
            AlarmCode := ALM_NO_RAW_PART; // 注释
            RETURN; // 注释
        END_IF; // 注释
//
        SelRawSlot := 0; // 注释
        FOR k := 1 TO 40 DO // 注释
            IF Trays[SelTrayRaw].RawSlotOccupied[k] AND (NOT Trays[SelTrayRaw].RawSlotProcessed[k]) THEN // 注释
                SelRawSlot := k; // 注释
                EXIT; // 注释
            END_IF; // 注释
        END_FOR; // 注释
        IF SelRawSlot = 0 THEN // 注释
            AlarmCode := ALM_TRAY_EMPTY; // 注释
            RETURN; // 注释
        END_IF; // 注释
//
        FoundFreeGrip := FALSE; // 注释
        FOR j := 1 TO 4 DO // 注释
            IF Grippers[j].Present AND Grippers[j].Healthy AND (NOT Grippers[j].HasPart) THEN // 注释
                FoundFreeGrip := TRUE; // 注释
                PartIDSeed := PartIDSeed + 1; // 注释
                Grippers[j].HasPart := TRUE; // 注释
                Grippers[j].PartID := PartIDSeed; // 注释
                Grippers[j].SourceTray := SelTrayRaw; // 注释
                Grippers[j].SourceSlot := SelRawSlot; // 注释
//
                // 机器人夹紧到位判断
                IF NOT RobotGripOK THEN // 注释
                    AlarmCode := ALM_ROBOT_GRIP_NOT_OK; // 注释
                    RETURN; // 注释
                END_IF; // 注释
//
                Trays[SelTrayRaw].RawSlotOccupied[SelRawSlot] := FALSE; // 注释
                Trays[SelTrayRaw].RawCount := Trays[SelTrayRaw].RawCount - 1; // 注释
//
                Machines[SelMachine].CurrentPartID := Grippers[j].PartID; // 注释
                Machines[SelMachine].CurrentSrcTray := Grippers[j].SourceTray; // 注释
                Machines[SelMachine].CurrentSrcSlot := Grippers[j].SourceSlot; // 注释
//
                Grippers[j].HasPart := FALSE; // 注释
                Grippers[j].PartID := 0; // 注释
                Grippers[j].SourceTray := 0; // 注释
                Grippers[j].SourceSlot := 0; // 注释
                EXIT; // 注释
            END_IF; // 注释
        END_FOR; // 注释
//
        IF NOT FoundFreeGrip THEN // 注释
            AlarmCode := ALM_GRIPPER_MISMATCH; // 注释
            RETURN; // 注释
        END_IF; // 注释
    END_IF; // 注释
//
    // 下料
    IF UnloadReq[SelMachine] THEN // 注释
        IF SelTrayDone = 0 THEN // 注释
            AlarmCode := ALM_TRAY_FULL; // 注释
            RETURN; // 注释
        END_IF; // 注释
//
        IF Machines[SelMachine].CurrentPartID = 0 THEN // 注释
            AlarmCode := ALM_GRIPPER_EMPTY; // 注释
            RETURN; // 注释
        END_IF; // 注释
//
        SelDoneSlot := 0; // 注释
        FOR k := 1 TO 40 DO // 注释
            IF NOT Trays[SelTrayDone].DoneSlotOccupied[k] THEN // 注释
                SelDoneSlot := k; // 注释
                EXIT; // 注释
            END_IF; // 注释
        END_FOR; // 注释
        IF SelDoneSlot = 0 THEN // 注释
            AlarmCode := ALM_TRAY_FULL; // 注释
            RETURN; // 注释
        END_IF; // 注释
//
        FoundFreeGrip := FALSE; // 注释
        FOR j := 1 TO 4 DO // 注释
            IF Grippers[j].Present AND Grippers[j].Healthy AND (NOT Grippers[j].HasPart) THEN // 注释
                FoundFreeGrip := TRUE; // 注释
//
                Grippers[j].HasPart := TRUE; // 注释
                Grippers[j].PartID := Machines[SelMachine].CurrentPartID; // 注释
//
                IF NOT RobotGripOK THEN // 注释
                    AlarmCode := ALM_ROBOT_GRIP_NOT_OK; // 注释
                    RETURN; // 注释
                END_IF; // 注释
//
                Trays[SelTrayDone].DoneSlotOccupied[SelDoneSlot] := TRUE; // 注释
                Trays[SelTrayDone].DoneCount := Trays[SelTrayDone].DoneCount + 1; // 注释
//
                // 把来源原料工位打上“已加工”标记
                IF (Machines[SelMachine].CurrentSrcTray >= 1) AND (Machines[SelMachine].CurrentSrcTray <= 4) THEN // 注释
                    IF (Machines[SelMachine].CurrentSrcSlot >= 1) AND (Machines[SelMachine].CurrentSrcSlot <= 40) THEN // 注释
                        Trays[Machines[SelMachine].CurrentSrcTray].RawSlotProcessed[Machines[SelMachine].CurrentSrcSlot] := TRUE; // 注释
                    END_IF; // 注释
                END_IF; // 注释
//
                Machines[SelMachine].CurrentPartID := 0; // 注释
                Machines[SelMachine].CurrentSrcTray := 0; // 注释
                Machines[SelMachine].CurrentSrcSlot := 0; // 注释
//
                Grippers[j].HasPart := FALSE; // 注释
                Grippers[j].PartID := 0; // 注释
                EXIT; // 注释
            END_IF; // 注释
        END_FOR; // 注释
//
        IF NOT FoundFreeGrip THEN // 注释
            AlarmCode := ALM_GRIPPER_MISMATCH; // 注释
            RETURN; // 注释
        END_IF; // 注释
    END_IF; // 注释
END_FUNCTION_BLOCK // 注释
//
FUNCTION "FC_CalcStats" : "T_CellStats" // 注释
VAR_INPUT // 注释
    Trays    : ARRAY[1..4] OF "T_Tray"; // 注释
    Machines : ARRAY[1..3] OF "T_MachineCtrl"; // 注释
END_VAR // 注释
VAR // 注释
    i        : INT; // 注释
    S        : "T_CellStats"; // 注释
END_VAR // 注释
BEGIN // 注释
    S.TotalRaw := 0; // 注释
    S.TotalDone := 0; // 注释
    S.TotalInProcess := 0; // 注释
//
    FOR i := 1 TO 4 DO // 注释
        S.TotalRaw := S.TotalRaw + INT_TO_DINT(Trays[i].RawCount); // 注释
        S.TotalDone := S.TotalDone + INT_TO_DINT(Trays[i].DoneCount); // 注释
        S.TrayRawRemain[i] := INT_TO_DINT(Trays[i].RawCount); // 注释
        S.TrayDoneCount[i] := INT_TO_DINT(Trays[i].DoneCount); // 注释
    END_FOR; // 注释
//
    FOR i := 1 TO 3 DO // 注释
        IF Machines[i].CurrentPartID <> 0 THEN // 注释
            S.TotalInProcess := S.TotalInProcess + 1; // 注释
        END_IF; // 注释
        S.MachineDone[i] := Machines[i].ProcessedCount; // 注释
        S.MachineAvgMs[i] := Machines[i].AvgProcessMs; // 注释
    END_FOR; // 注释
//
    S.RemainingRaw := S.TotalRaw; // 注释
    "FC_CalcStats" := S; // 注释
END_FUNCTION // 注释
//
FUNCTION_BLOCK "FB_FlexibleCell" // 注释
VAR_INPUT // 注释
    HMI            : "T_HMI"; // 注释
    Safety         : "T_Safety"; // 注释
    RobotReady     : BOOL; // 注释
    RobotFault     : BOOL; // 注释
    RobotInCycle   : BOOL; // 注释
    RobotGripOK    : BOOL; // 注释
    TrayRawPlaceOK : ARRAY[1..4] OF BOOL; // 注释
    TrayDonePlaceOK: ARRAY[1..4] OF BOOL; // 注释
    MachineReadyIn : ARRAY[1..3] OF BOOL; // 注释
    MachineFaultIn : ARRAY[1..3] OF BOOL; // 注释
    MachineDoorIn  : ARRAY[1..3] OF BOOL; // 注释
    MachineClampIn : ARRAY[1..3] OF BOOL; // 注释
    MachineDoneIn  : ARRAY[1..3] OF BOOL; // 注释
END_VAR // 注释
VAR_OUTPUT // 注释
    CellState      : "E_CellState"; // 注释
    AlarmActive    : BOOL; // 注释
    AlarmCode      : "E_AlarmCode"; // 注释
    AlarmTextID    : INT; // 注释
    StopAll        : BOOL; // 注释
    RobotStartCmd  : BOOL; // 注释
    LoadReq        : ARRAY[1..3] OF BOOL; // 注释
    UnloadReq      : ARRAY[1..3] OF BOOL; // 注释
    MachineRunCmd  : ARRAY[1..3] OF BOOL; // 注释
    SelectedMachine: INT; // 注释
    Stats          : "T_CellStats"; // 注释
END_VAR // 注释
VAR // 注释
    i, k           : INT; // 注释
    SafetyAlarm    : "E_AlarmCode"; // 注释
    RobotAlarm     : "E_AlarmCode"; // 注释
    MIO            : ARRAY[1..3] OF "T_MachineIO"; // 注释
    MCtrl          : ARRAY[1..3] OF "T_MachineCtrl"; // 注释
    Trays          : ARRAY[1..4] OF "T_Tray"; // 注释
    Grippers       : ARRAY[1..4] OF "T_Gripper"; // 注释
    PartIDSeed     : DINT; // 注释
    StartEdge      : R_TRIG; // 注释
    ResetEdge      : R_TRIG; // 注释
    DoorFall       : F_TRIG; // 注释
    FB_M1          : "FB_MachineUnit"; // 注释
    FB_M2          : "FB_MachineUnit"; // 注释
    FB_M3          : "FB_MachineUnit"; // 注释
    FB_Robot       : "FB_RobotDispatcher"; // 注释
END_VAR // 注释
BEGIN // 注释
    StartEdge(CLK := HMI.CmdStart); // 注释
    ResetEdge(CLK := HMI.CmdReset); // 注释
    DoorFall(CLK := Safety.SafetyDoorClosed); // 注释
//
    // 初始化托盘与手抓
    FOR i := 1 TO 4 DO // 注释
        IF Trays[i].Capacity = 0 THEN // 注释
            Trays[i].Capacity := 40; // 注释
        END_IF; // 注释
        IF NOT Trays[i].InitDone THEN // 注释
            // 若工程师已在DB写入RawCount，则自动占用前RawCount个原料位
            FOR k := 1 TO 40 DO // 注释
                Trays[i].RawSlotOccupied[k] := FALSE; // 注释
                Trays[i].RawSlotProcessed[k] := FALSE; // 注释
                Trays[i].DoneSlotOccupied[k] := FALSE; // 注释
            END_FOR; // 注释
            FOR k := 1 TO Trays[i].RawCount DO // 注释
                IF k <= 40 THEN // 注释
                    Trays[i].RawSlotOccupied[k] := TRUE; // 注释
                END_IF; // 注释
            END_FOR; // 注释
            Trays[i].InitDone := TRUE; // 注释
        END_IF; // 注释
//
        IF NOT Grippers[i].Present THEN // 注释
            Grippers[i].Present := TRUE; // 注释
        END_IF; // 注释
        IF NOT Grippers[i].Healthy THEN // 注释
            Grippers[i].Healthy := TRUE; // 注释
        END_IF; // 注释
    END_FOR; // 注释
//
    FOR i := 1 TO 3 DO // 注释
        MIO[i].Ready := MachineReadyIn[i]; // 注释
        MIO[i].Fault := MachineFaultIn[i]; // 注释
        MIO[i].DoorClosed := MachineDoorIn[i]; // 注释
        MIO[i].ClampOK := MachineClampIn[i]; // 注释
        MIO[i].CycleDone := MachineDoneIn[i]; // 注释
    END_FOR; // 注释
//
    SafetyAlarm := "FC_CheckSafetyAndAlarm"( // 注释
        Safety := Safety, // 注释
        M1Fault := MIO[1].Fault, // 注释
        M2Fault := MIO[2].Fault, // 注释
        M3Fault := MIO[3].Fault, // 注释
        RobotFault := RobotFault // 注释
    ); // 注释
//
    AlarmCode := SafetyAlarm; // 注释
    AlarmActive := (AlarmCode <> ALM_NONE); // 注释
    AlarmTextID := "FC_AlarmTextID"(Code := AlarmCode); // 注释
//
    IF DoorFall.Q THEN // 注释
        CellState := ST_FAULT; // 注释
    END_IF; // 注释
//
    CASE CellState OF // 注释
        ST_INIT: // 注释
            StopAll := TRUE; // 注释
            FOR i := 1 TO 3 DO // 注释
                MCtrl[i].State := MC_IDLE; // 注释
            END_FOR; // 注释
            IF HMI.ModeAuto THEN // 注释
                CellState := ST_IDLE; // 注释
            END_IF; // 注释
//
        ST_IDLE: // 注释
            StopAll := TRUE; // 注释
            IF AlarmActive THEN // 注释
                CellState := ST_FAULT; // 注释
            ELSIF StartEdge.Q AND HMI.ModeAuto THEN // 注释
                CellState := ST_AUTO_RUN; // 注释
            END_IF; // 注释
//
        ST_AUTO_RUN: // 注释
            StopAll := FALSE; // 注释
            IF HMI.CmdStop THEN // 注释
                CellState := ST_STOPPING; // 注释
            ELSIF AlarmActive THEN // 注释
                CellState := ST_FAULT; // 注释
            ELSE // 注释
                FB_M1(Enable := TRUE, IO := MIO[1], PartLoaded := (MCtrl[1].CurrentPartID <> 0), Ctrl := MCtrl[1]); // 注释
                FB_M2(Enable := TRUE, IO := MIO[2], PartLoaded := (MCtrl[2].CurrentPartID <> 0), Ctrl := MCtrl[2]); // 注释
                FB_M3(Enable := TRUE, IO := MIO[3], PartLoaded := (MCtrl[3].CurrentPartID <> 0), Ctrl := MCtrl[3]); // 注释
//
                FOR i := 1 TO 3 DO // 注释
                    LoadReq[i] := MCtrl[i].LoadReq; // 注释
                    UnloadReq[i] := MCtrl[i].UnloadReq; // 注释
                    MachineRunCmd[i] := MCtrl[i].RunCmd; // 注释
                END_FOR; // 注释
//
                // 机床夹紧到位判断（有料时必须夹紧）
                FOR i := 1 TO 3 DO // 注释
                    IF (MCtrl[i].CurrentPartID <> 0) AND (NOT MIO[i].ClampOK) AND (MCtrl[i].State = MC_PROCESSING) THEN // 注释
                        AlarmCode := ALM_MACHINE_CLAMP_NOT_OK; // 注释
                        AlarmActive := TRUE; // 注释
                        AlarmTextID := "FC_AlarmTextID"(Code := AlarmCode); // 注释
                        CellState := ST_FAULT; // 注释
                    END_IF; // 注释
                END_FOR; // 注释
//
                IF CellState = ST_AUTO_RUN THEN // 注释
                    FB_Robot( // 注释
                        RobotReady := RobotReady, // 注释
                        RobotInCycle := RobotInCycle, // 注释
                        RobotGripOK := RobotGripOK, // 注释
                        LoadReq := LoadReq, // 注释
                        UnloadReq := UnloadReq, // 注释
                        TrayRawPlaceOK := TrayRawPlaceOK, // 注释
                        TrayDonePlaceOK := TrayDonePlaceOK, // 注释
                        Trays := Trays, // 注释
                        Grippers := Grippers, // 注释
                        Machines := MCtrl, // 注释
                        PartIDSeed := PartIDSeed, // 注释
                        RobotStartCmd => RobotStartCmd, // 注释
                        AlarmCode => RobotAlarm, // 注释
                        SelectedMachine => SelectedMachine // 注释
                    ); // 注释
//
                    IF RobotAlarm <> ALM_NONE THEN // 注释
                        AlarmCode := RobotAlarm; // 注释
                        AlarmActive := TRUE; // 注释
                        AlarmTextID := "FC_AlarmTextID"(Code := AlarmCode); // 注释
                        CellState := ST_FAULT; // 注释
                    END_IF; // 注释
                END_IF; // 注释
            END_IF; // 注释
//
        ST_STOPPING: // 注释
            StopAll := TRUE; // 注释
            RobotStartCmd := FALSE; // 注释
            FOR i := 1 TO 3 DO // 注释
                LoadReq[i] := FALSE; // 注释
                UnloadReq[i] := FALSE; // 注释
                MachineRunCmd[i] := FALSE; // 注释
            END_FOR; // 注释
            IF NOT HMI.CmdStop THEN // 注释
                CellState := ST_IDLE; // 注释
            END_IF; // 注释
//
        ST_FAULT: // 注释
            StopAll := TRUE; // 注释
            RobotStartCmd := FALSE; // 注释
            FOR i := 1 TO 3 DO // 注释
                LoadReq[i] := FALSE; // 注释
                UnloadReq[i] := FALSE; // 注释
                MachineRunCmd[i] := FALSE; // 注释
            END_FOR; // 注释
            IF HMI.AckAlarm AND ResetEdge.Q AND (SafetyAlarm = ALM_NONE) THEN // 注释
                AlarmCode := ALM_NONE; // 注释
                AlarmActive := FALSE; // 注释
                AlarmTextID := 0; // 注释
                CellState := ST_IDLE; // 注释
            END_IF; // 注释
    END_CASE; // 注释
//
    Stats := "FC_CalcStats"(Trays := Trays, Machines := MCtrl); // 注释
END_FUNCTION_BLOCK // 注释
